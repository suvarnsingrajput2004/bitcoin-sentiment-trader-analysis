{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "GitHub Profile Analyzer API",
    "description": "A complete Postman collection for the GitHub Profile Analyzer REST API.\n\nThis API retrieves, analyzes, and stores public GitHub profile data and repository insights using Node.js, Express, and MySQL.\n\n## Base URL\n`http://localhost:5000`\n\n## Endpoints\n1. Analyze GitHub Profile\n2. Get All Profiles (with pagination & search)\n3. Get Profile by Database ID\n4. Get Profile by GitHub Username\n5. Delete Profile by Database ID\n\n## Setup\n1. Clone the repository\n2. Run `npm install`\n3. Configure `.env` with your MySQL credentials\n4. Import `schema.sql` into MySQL\n5. Run `npm start`\n6. Import this collection into Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL of the API server. Change this to your deployed URL when using a live environment."
    },
    {
      "key": "username",
      "value": "octocat",
      "type": "string",
      "description": "Default GitHub username used in requests."
    },
    {
      "key": "profile_id",
      "value": "1",
      "type": "string",
      "description": "Default database profile ID used in requests."
    }
  ],
  "item": [
    {
      "name": "1. Analyze GitHub User Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success true\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "});",
              "",
              "pm.test(\"Response contains profile data\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.have.property('username');",
              "    pm.expect(json.data).to.have.property('total_stars');",
              "    pm.expect(json.data).to.have.property('total_forks');",
              "    pm.expect(json.data).to.have.property('most_starred_repository');",
              "    pm.expect(json.data).to.have.property('most_used_programming_language');",
              "});",
              "",
              "// Auto-save the returned ID for use in other requests",
              "const json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "    pm.collectionVariables.set('profile_id', json.data.id);",
              "    console.log('Saved profile_id:', json.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/analyze/{{username}}",
          "host": ["{{base_url}}"],
          "path": ["api", "analyze", "{{username}}"]
        },
        "description": "Fetches the GitHub profile for a given username, computes repository insights (total stars, forks, most starred repo, dominant language, etc.), saves/updates the data in MySQL, and returns the full analyzed result.\n\n**URL Parameter:**\n- `username` (required): A valid GitHub username (e.g., `octocat`, `torvalds`, `gaearon`)\n\n**Notes:**\n- If the profile already exists in the database, it will be updated (upsert).\n- Rate-limited to 100 requests per 15 minutes per IP."
      },
      "response": [
        {
          "name": "Success - Profile Analyzed",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analyze/octocat",
              "host": ["{{base_url}}"],
              "path": ["api", "analyze", "octocat"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"message\": \"GitHub profile for 'octocat' has been successfully analyzed and stored.\",\n  \"data\": {\n    \"id\": 1,\n    \"username\": \"octocat\",\n    \"name\": \"The Octocat\",\n    \"bio\": \"GitHub's mascot\",\n    \"avatar_url\": \"https://avatars.githubusercontent.com/u/583231?v=4\",\n    \"profile_url\": \"https://github.com/octocat\",\n    \"public_repos\": 8,\n    \"followers\": 15000,\n    \"following\": 9,\n    \"created_at\": \"2011-01-25T18:44:36.000Z\",\n    \"updated_at\": \"2024-03-22T12:00:00.000Z\",\n    \"account_age_years\": 15.37,\n    \"total_repositories\": 8,\n    \"total_stars\": 350,\n    \"total_forks\": 120,\n    \"most_starred_repository\": \"Spoon-Knife\",\n    \"most_used_programming_language\": \"HTML\",\n    \"average_stars_per_repository\": 43.75,\n    \"analyzed_at\": \"2026-06-09T07:30:00.000Z\"\n  }\n}"
        },
        {
          "name": "Error - User Not Found (404)",
          "originalRequest": {
            "method": "GET",
            "header": [],
