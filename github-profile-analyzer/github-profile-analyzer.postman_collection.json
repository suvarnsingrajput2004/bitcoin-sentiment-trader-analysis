    },
    {
      "name": "2. Get All Analyzed Profiles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success true\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "});",
              "",
              "pm.test(\"Response has pagination metadata\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.pagination).to.have.property('total_records');",
              "    pm.expect(json.pagination).to.have.property('current_page');",
              "    pm.expect(json.pagination).to.have.property('total_pages');",
              "    pm.expect(json.pagination).to.have.property('limit');",
              "});",
              "",
              "pm.test(\"Response data is an array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/profiles?page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["api", "profiles"],
          "query": [
            {
              "key": "page",
              "value": "1",
              "description": "Page number (default: 1)"
            },
            {
              "key": "limit",
              "value": "10",
              "description": "Records per page (default: 10, max: 100)"
            },
            {
              "key": "search",
              "value": "",
              "description": "Search keyword to filter by username or name",
              "disabled": true
            }
          ]
        },
        "description": "Retrieves all analyzed profiles stored in the MySQL database.\n\n**Query Parameters (all optional):**\n- `page`: Page number for pagination (default: `1`)\n- `limit`: Records per page (default: `10`, max: `100`)\n- `search`: Filter results by matching `username` or `name`\n\n**Example Variations:**\n- Paginate: `?page=2&limit=5`\n- Search: `?search=torvalds`\n- Combined: `?page=1&limit=5&search=octo`"
      },
      "response": [
        {
          "name": "Success - Profiles Listed",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/profiles?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"username\": \"octocat\",\n      \"name\": \"The Octocat\",\n      \"bio\": \"GitHub's mascot\",\n      \"avatar_url\": \"https://avatars.githubusercontent.com/u/583231?v=4\",\n      \"profile_url\": \"https://github.com/octocat\",\n      \"public_repos\": 8,\n      \"followers\": 15000,\n      \"following\": 9,\n      \"total_stars\": 350,\n      \"total_forks\": 120,\n      \"most_starred_repository\": \"Spoon-Knife\",\n      \"most_used_programming_language\": \"HTML\",\n      \"average_stars_per_repository\": 43.75,\n      \"analyzed_at\": \"2026-06-09T07:30:00.000Z\"\n    }\n  ],\n  \"pagination\": {\n    \"total_records\": 1,\n    \"current_page\": 1,\n    \"limit\": 10,\n    \"total_pages\": 1\n  }\n}"
        }
      ]
    },
